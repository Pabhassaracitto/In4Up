<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- OAuth redirect (đã có nếu dùng Firebase) -->
    <!-- THÊM: Để fix lỗi 'No permissions found for []15' trên Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- XLAT-SCR-002: Dịch màn hình TOÀN HỆ THỐNG (bong bóng + chụp màn hình).
         - SYSTEM_ALERT_WINDOW: vẽ bong bóng + lớp bản dịch đè lên app khác
           (user phải bật tay trong Settings, app chỉ mở được màn hình đó).
         - FOREGROUND_SERVICE_MEDIA_PROJECTION: bắt buộc từ API 34 khi service
           giữ MediaProjection; SPECIAL_USE cho giai đoạn chỉ có bong bóng
           (chưa xin consent) — Android 14 chặn type mediaProjection khi chưa
           có token projection.
         - POST_NOTIFICATIONS: API 33+ cần để hiện notification điều khiển.
         - VIBRATE: XLAT-SCR-003 — rung nhẹ khi bong bóng KHÔNG làm được việc,
           để user biết có chuyện gì ngay cả khi notification bị ẩn. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- BATTERY-OPT-001: Xin miễn tối ưu pin để app (STT/AI models, tải model,
         phát audio dài) không bị hệ thống giết khi chạy ngầm. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:roundIcon="@mipmap/launcher_icon"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"> <!--  Dòng này ép điện thoại phải giải nén toàn bộ thư viện âm thanh ra bộ nhớ khi cài đặt, đảm bảo plugin audio tìm thấy file thực thi.  -->

        <!-- ML Kit Subject Segmentation is an unbundled Play Services model.
             Processing is offline after Play Services has installed the model;
             the model is not copied into this APK. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.googleusercontent.apps.CLIENT_ID"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Handle audio files -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- ADR-0018 P1 — deep link từ điển: in4up://dict?w=… và
                 in4up://open?path=… (mở tệp, P3).
                 `BROWSABLE` + `VIEW` là mức tối thiểu để link bấm được từ
                 trình duyệt/Zalo/Telegram. KHÔNG khai `*/*`: menu "Mở bằng"
                 của người dùng chỉ được thấy In4Up cho đúng thứ app đọc được.
                 Việc kiểm tra an toàn (độ dài từ, đuôi tệp, `..`) nằm ở Dart
                 (`features/dictionary/services/dict_deep_link.dart`) — native
                 chỉ chuyển tiếp URL thô. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="in4up" android:host="dict" />
                <data android:scheme="in4up" android:host="open" />
                <data android:scheme="i4u" android:host="dict" />
                <data android:scheme="i4u" android:host="open" />
            </intent-filter>
        </activity>

        <!-- XLAT-SCR-002 / XLAT-SCR-003 — Dịch màn hình toàn hệ thống (ADR-0011).
             Service giữ bong bóng + MediaProjection + engine Flutter nền;
             activity trong suốt chỉ để xin consent chụp màn hình.

             ĐÃ KIỂM TRA CHÉO với android/app/build.gradle.kts (2026-10-07):
               compileSdk 36 · targetSdk 35 · minSdk 24.
             - targetSdk 35 (Android 15) ⇒ bắt buộc khai báo
               `android:foregroundServiceType` và quyền FGS tương ứng; thiếu là
               MissingForegroundServiceTypeException lúc startForeground.
             - `mediaProjection` cần quyền FOREGROUND_SERVICE_MEDIA_PROJECTION
               (đã khai ở trên) và CHỈ được dùng SAU khi đã gọi
               createScreenCaptureIntent + user đồng ý (thứ tự bắt buộc của
               Android 14). `specialUse` dùng cho giai đoạn chỉ có bong bóng.
             - Activity xin consent KHÔNG đổi: vẫn `exported=false`,
               trong suốt, noHistory. Nó được mở bằng PendingIntent có opt-in
               MODE_BACKGROUND_ACTIVITY_START_ALLOWED (Android 14+) hoặc từ
               MainActivity khi app còn foreground — KHÔNG bao giờ bằng
               Context.startActivity từ service (Android 10+ chặn im lặng). -->
        <service
            android:name="com.in4up.screentranslate.ScreenTranslateService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating screen-translate bubble kept alive while the user browses other apps" />
        </service>

        <activity
            android:name="com.in4up.screentranslate.ScreenCaptureRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- PSRC-221 — in4up là engine "Chuyển văn bản thành giọng nói" của
             Android (Cài đặt ▸ Ngôn ngữ & nhập ▸ Chuyển văn bản thành giọng nói).

             - Android tìm engine bằng action `android.intent.action.TTS_SERVICE`
               + metadata `android.speech.tts` ⇒ service PHẢI `exported=true`
               (hệ thống và app khác bind vào). Không khai `permission`: engine
               TTS chuẩn không yêu cầu quyền nào để được bind.
             - Tên hiển thị trong danh sách engine = nhãn app (`app_name` theo
               flavor) — không thêm chuỗi mới.
             - Ba activity dưới là giao thức của màn Cài đặt TTS:
               CHECK_TTS_DATA (bắt buộc — thiếu thì nút "Nghe thử" bị khoá),
               GET_SAMPLE_TEXT (câu nghe thử), INSTALL_TTS_DATA (mở app để
               import giọng). Không có giao diện.
             - Không cần `<queries>`: đó là việc của app GỌI engine, không phải
               của engine. targetSdk 35 không đòi thêm khai báo nào để hiện
               trong danh sách.
             - Âm thanh do engine Flutter NỀN tạo (Piper/VieNeu offline) —
               xem com.in4up.systemtts.SystemTtsRuntime. -->
        <service
            android:name="com.in4up.systemtts.In4UpTtsService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <activity
            android:name="com.in4up.systemtts.CheckVoiceDataActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.in4up.systemtts.GetSampleTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.in4up.systemtts.InstallVoiceDataActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <!-- OCR-SCAN-CRASH-001: Android 11+ chặn truy vấn gói không khai báo.
             OcrPrecheck hỏi PackageManager xem máy có Google Play services
             không TRƯỚC khi mở máy quét tài liệu (thư viện "unbundled" của ML
             Kit nằm trong Play services — thiếu là lỗi ném ở luồng native).
             KHÔNG xin quyền CAMERA: máy quét dùng camera của Play services. -->
        <package android:name="com.google.android.gms" />
    </queries>
</manifest>