<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- OAuth redirect (đã có nếu dùng Firebase) -->
    <!-- THÊM: Để fix lỗi 'No permissions found for []15' trên Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- XLAT-SCR-002: Dịch màn hình TOÀN HỆ THỐNG (bong bóng + chụp màn hình).
         - SYSTEM_ALERT_WINDOW: vẽ bong bóng + lớp bản dịch đè lên app khác
           (user phải bật tay trong Settings, app chỉ mở được màn hình đó).
         - FOREGROUND_SERVICE_MEDIA_PROJECTION: bắt buộc từ API 34 khi service
           giữ MediaProjection; SPECIAL_USE cho giai đoạn chỉ có bong bóng
           (chưa xin consent) — Android 14 chặn type mediaProjection khi chưa
           có token projection.
         - POST_NOTIFICATIONS: API 33+ cần để hiện notification điều khiển.
         - VIBRATE: XLAT-SCR-003 — rung nhẹ khi bong bóng KHÔNG làm được việc,
           để user biết có chuyện gì ngay cả khi notification bị ẩn. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- BATTERY-OPT-001: Xin miễn tối ưu pin để app (STT/AI models, tải model,
         phát audio dài) không bị hệ thống giết khi chạy ngầm. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:roundIcon="@mipmap/launcher_icon"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"> <!--  Dòng này ép điện thoại phải giải nén toàn bộ thư viện âm thanh ra bộ nhớ khi cài đặt, đảm bảo plugin audio tìm thấy file thực thi.  -->

        <!-- ML Kit Subject Segmentation is an unbundled Play Services model.
             Processing is offline after Play Services has installed the model;
             the model is not copied into this APK. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.googleusercontent.apps.CLIENT_ID"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Handle audio files -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- XLAT-SCR-002 / XLAT-SCR-003 — Dịch màn hình toàn hệ thống (ADR-0011).
             Service giữ bong bóng + MediaProjection + engine Flutter nền;
             activity trong suốt chỉ để xin consent chụp màn hình.

             ĐÃ KIỂM TRA CHÉO với android/app/build.gradle.kts (2026-10-07):
               compileSdk 36 · targetSdk 35 · minSdk 24.
             - targetSdk 35 (Android 15) ⇒ bắt buộc khai báo
               `android:foregroundServiceType` và quyền FGS tương ứng; thiếu là
               MissingForegroundServiceTypeException lúc startForeground.
             - `mediaProjection` cần quyền FOREGROUND_SERVICE_MEDIA_PROJECTION
               (đã khai ở trên) và CHỈ được dùng SAU khi đã gọi
               createScreenCaptureIntent + user đồng ý (thứ tự bắt buộc của
               Android 14). `specialUse` dùng cho giai đoạn chỉ có bong bóng.
             - Activity xin consent KHÔNG đổi: vẫn `exported=false`,
               trong suốt, noHistory. Nó được mở bằng PendingIntent có opt-in
               MODE_BACKGROUND_ACTIVITY_START_ALLOWED (Android 14+) hoặc từ
               MainActivity khi app còn foreground — KHÔNG bao giờ bằng
               Context.startActivity từ service (Android 10+ chặn im lặng). -->
        <service
            android:name="com.in4up.screentranslate.ScreenTranslateService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating screen-translate bubble kept alive while the user browses other apps" />
        </service>

        <activity
            android:name="com.in4up.screentranslate.ScreenCaptureRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
    </queries>
</manifest>