<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_flashcard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@string/widget_default_garden_header"
            android:src="@drawable/ic_widget_leaf" />

        <TextView
            android:id="@+id/txt_garden_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_default_garden_header"
            android:textColor="#FF9FA8DA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_srs_due_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_badge"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:text="0"
            android:textColor="#FF00E676"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/box_srs_card_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_card_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_card_ipa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#FF80DEEA"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_card_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_default_srs_empty"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <!-- QUY TẮC VÀNG #2: 3 thanh kỹ năng SM-2 tách biệt Hiểu · Nghe · Đọc -->
        <LinearLayout
            android:id="@+id/row_three_skills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lbl_skill_understand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_understand"
                android:textColor="#FF64B5F6"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/bar_skill_understand"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="#FF42A5F5" />

            <TextView
                android:id="@+id/lbl_skill_listen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_listen"
                android:textColor="#FF81C784"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/bar_skill_listen"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="#FF66BB6A" />

            <TextView
                android:id="@+id/lbl_skill_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_read"
                android:textColor="#FFFF8A65"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/bar_skill_read"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFEF5350" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_flip_card"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_inner_tile"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/widget_default_flip_show"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_next_card"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_widget_inner_tile"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/widget_default_next_card"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_review_now"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_widget_cta"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/widget_default_review_now"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
