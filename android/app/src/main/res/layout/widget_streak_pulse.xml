<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/widget_default_streak_header"
            android:src="@drawable/ic_widget_fire" />

        <TextView
            android:id="@+id/txt_streak_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_default_streak_headline"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_streak_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_default_streak_today"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <!-- 7 ô mức hoạt động 7 ngày gần nhất (tương thích RemoteViews API 24+) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/day_pill_0"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription=""
                android:src="@drawable/bg_widget_day_idle" />

            <TextView
                android:id="@+id/day_lbl_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#80FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/day_pill_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription=""
                android:src="@drawable/bg_widget_day_idle" />

            <TextView
                android:id="@+id/day_lbl_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#80FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/day_pill_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription=""
                android:src="@drawable/bg_widget_day_idle" />

            <TextView
                android:id="@+id/day_lbl_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#80FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/day_pill_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription=""
                android:src="@drawable/bg_widget_day_idle" />

            <TextView
                android:id="@+id/day_lbl_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#80FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/day_pill_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription=""
                android:src="@drawable/bg_widget_day_idle" />

            <TextView
                android:id="@+id/day_lbl_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#80FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/day_pill_5"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription=""
                android:src="@drawable/bg_widget_day_idle" />

            <TextView
                android:id="@+id/day_lbl_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#80FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/day_pill_6"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription=""
                android:src="@drawable/bg_widget_day_idle" />

            <TextView
                android:id="@+id/day_lbl_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-"
                android:textColor="#80FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btn_streak_cta"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_cta"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="@string/widget_default_start_learning"
        android:textColor="#FFFFFFFF"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
