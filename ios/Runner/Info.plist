<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>

	<string>com.googleusercontent.apps.342774597309-jluaq6rre869dipiq2jv62lap93nkihv</string>
				<!-- ADR-0018 P1 — deep link từ điển: in4up://dict?w=… -->
				<string>in4up</string>
			</array>
		</dict>
	</array>
	
	<key>GIDClientID</key>
	<string>342774597309-jluaq6rre869dipiq2jv62lap93nkihv.apps.googleusercontent.com</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>In4Up</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>In4Up</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- PSRC-204 / ADR-0029: hiển thị thư mục Documents/In4Up trong ứng dụng
	     Tệp (Files → On My iPhone/In4Up) để người dùng thấy tệp xuất ngay. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- PSRC-222: cho phép "Mở bằng In4Up" từ ứng dụng Tệp / Chia sẻ trên iOS
	     cho tài liệu (.txt, .md, .pdf, .docx), âm thanh (.mp3, .m4a...) và video (.mp4...).
	     KHÔNG nhận public.item hay public.data chung chung. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>In4Up Document</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>org.openxmlformats.wordprocessingml.document</string>
				<string>public.plain-text</string>
				<string>net.daringfireball.markdown</string>
				<string>public.text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>In4Up Audio</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>public.mp3</string>
				<string>public.mpeg-4-audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>In4Up Video</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.mpeg-4</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>In4Up dùng camera để chụp ảnh minh họa cho từ vựng.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>In4Up dùng thư viện ảnh để chọn ảnh minh họa cho từ vựng.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- WP0 (API-001): cho phép gọi server AI trong LAN qua http
		     (Ollama/LM Studio…). KHÔNG bật NSAllowsArbitraryLoads —
		     cloud provider vẫn bắt buộc https (guard thêm trong
		     OpenAiCompatClient.isCleartextAllowed). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
