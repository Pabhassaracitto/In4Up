/// Service tích hợp english_syntax_highlighter
/// với hệ thống phân tích từ của VipSound
class SyntaxHighlighterService {
  SyntaxHighlighterService._();
  static final instance = SyntaxHighlighterService._();

  // Cache kết quả phân tích theo dòng text
  final Map<String, List<AnalyzedWord>> _cache = {};
  static const int _maxCacheSize = 500;

  // Instance highlighter - khởi tạo 1 lần
  late final EnglishSyntaxHighlighter _highlighter;
  bool _initialized = false;

  /// Khởi tạo service (gọi 1 lần trong main hoặc provider)
  Future<void> initialize() async {
    if (_initialized) return;
    _highlighter = EnglishSyntaxHighlighter();
    _initialized = true;
  }

  /// Phân tích 1 câu → danh sách AnalyzedWord
  List<AnalyzedWord> analyzeLine(String text) {
    if (text.trim().isEmpty) return [];

    // Check cache
    if (_cache.containsKey(text)) {
      return _cache[text]!;
    }

    List<AnalyzedWord> result;

    try {
      if (_initialized) {
        result = _analyzeWithHighlighter(text);
      } else {
        result = _analyzeBasic(text);
      }
    } catch (e) {
      // Fallback nếu highlighter lỗi
      debugPrint('SyntaxHighlighter error: $e');
      result = _analyzeBasic(text);
    }

    // Cache management
    if (_cache.length >= _maxCacheSize) {
      // Xóa 20% cache cũ nhất
      final keysToRemove = _cache.keys.take(_maxCacheSize ~/ 5).toList();
      for (final key in keysToRemove) {
        _cache.remove(key);
      }
    }
    _cache[text] = result;

    return result;
  }

  /// Phân tích toàn bộ văn bản (nhiều dòng)
  List<List<AnalyzedWord>> analyzeAllLines(List<String> lines) {
    return lines.map((line) => analyzeLine(line)).toList();
  }

  /// ===== PHÂN TÍCH VỚI english_syntax_highlighter =====
  List<AnalyzedWord> _analyzeWithHighlighter(String text) {
    // Sử dụng package để lấy tokens
    final highlighted = _highlighter.highlight(text);

    // Parse TextSpan tree → flat list of AnalyzedWord
    final words = <AnalyzedWord>[];
    _extractWordsFromSpan(highlighted, words);

    // Nếu highlighter không trả về gì hữu ích, fallback
    if (words.isEmpty) {
      return _analyzeBasic(text);
    }

    return words;
  }

  /// Đệ quy extract words từ TextSpan tree
  void _extractWordsFromSpan(TextSpan span, List<AnalyzedWord> words) {
    if (span.text != null && span.text!.trim().isNotEmpty) {
      final wordType = _mapStyleToWordType(span.style);
      final cefrLevel = _estimateCEFR(span.text!.trim().toLowerCase());

      // Tách từng từ (nếu span chứa nhiều từ)
      final tokens = span.text!.split(RegExp(r'\s+'));
      for (final token in tokens) {
        if (token.trim().isEmpty) continue;
        words.add(AnalyzedWord(
          word: token,
          wordType: wordType,
          cefrLevel: cefrLevel,
          meaning: _getQuickMeaning(token.toLowerCase(), wordType),
        ));
      }
    }

    // Recurse children
    if (span.children != null) {
      for (final child in span.children!) {
        if (child is TextSpan) {
          _extractWordsFromSpan(child, words);
        }
      }
    }
  }

  /// Map TextStyle từ highlighter → WordType của VipSound
  WordType _mapStyleToWordType(TextStyle? style) {
    if (style == null || style.color == null) return WordType.unknown;

    final color = style.color!;

    // Map màu của english_syntax_highlighter → WordType
    // (Điều chỉnh theo palette thực tế của package)
    if (_isColorClose(color, Colors.blue) ||
        _isColorClose(color, const Color(0xFF569CD6))) {
      return WordType.noun;
    }
    if (_isColorClose(color, Colors.red) ||
        _isColorClose(color, const Color(0xFFD7BA7D))) {
      return WordType.verb;
    }
    if (_isColorClose(color, Colors.green) ||
        _isColorClose(color, const Color(0xFFB5CEA8))) {
      return WordType.adjective;
    }
    if (_isColorClose(color, Colors.orange) ||
        _isColorClose(color, const Color(0xFFCE9178))) {
      return WordType.adverb;
    }
    if (_isColorClose(color, Colors.purple) ||
        _isColorClose(color, const Color(0xFFC586C0))) {
      return WordType.preposition;
    }
    if (_isColorClose(color, Colors.cyan) ||
        _isColorClose(color, const Color(0xFF9CDCFE))) {
      return WordType.pronoun;
    }
    if (_isColorClose(color, Colors.teal)) {
      return WordType.conjunction;
    }
    if (_isColorClose(color, Colors.grey)) {
      return WordType.determiner;
    }

    return WordType.unknown;
  }

  /// Kiểm tra 2 màu có gần nhau không
  bool _isColorClose(Color a, Color b, {int threshold = 60}) {
    return (a.red - b.red).abs() < threshold &&
        (a.green - b.green).abs() < threshold &&
        (a.blue - b.blue).abs() < threshold;
  }

  /// ===== FALLBACK: Phân tích cơ bản (không cần package) =====
  List<AnalyzedWord> _analyzeBasic(String text) {
    final words = <AnalyzedWord>[];
    final tokens = text.split(RegExp(r'(\s+)'));

    for (final token in tokens) {
      if (token.trim().isEmpty) continue;

      final clean = token.replaceAll(RegExp(r'[^\w]'), '').toLowerCase();
      if (clean.isEmpty) {
        words.add(AnalyzedWord(
          word: token,
          wordType: WordType.unknown,
          cefrLevel: CEFRLevel.unknown,
        ));
        continue;
      }

      final wordType = _classifyWordBasic(clean);
      final cefrLevel = _estimateCEFR(clean);

      words.add(AnalyzedWord(
        word: token,
        wordType: wordType,
        cefrLevel: cefrLevel,
        meaning: _getQuickMeaning(clean, wordType),
      ));
    }
    return words;
  }

  /// Phân loại từ cơ bản (rule-based)
  WordType _classifyWordBasic(String word) {
    // Pronouns
    if (_pronouns.contains(word)) return WordType.pronoun;
    // Determiners
    if (_determiners.contains(word)) return WordType.determiner;
    // Prepositions
    if (_prepositions.contains(word)) return WordType.preposition;
    // Conjunctions
    if (_conjunctions.contains(word)) return WordType.conjunction;
    // Common verbs
    if (_commonVerbs.contains(word)) return WordType.verb;
    // Verb patterns
    if (word.endsWith('ing') ||
        word.endsWith('ed') ||
        word.endsWith('ize') ||
        word.endsWith('ise') ||
        word.endsWith('ate') ||
        word.endsWith('ify')) {
      return WordType.verb;
    }
    // Adverb patterns
    if (word.endsWith('ly') && word.length > 3) return WordType.adverb;
    // Adjective patterns
    if (word.endsWith('ful') ||
        word.endsWith('less') ||
        word.endsWith('ous') ||
        word.endsWith('ive') ||
        word.endsWith('able') ||
        word.endsWith('ible') ||
        word.endsWith('ical') ||
        word.endsWith('ish')) {
      return WordType.adjective;
    }
    // Noun patterns
    if (word.endsWith('tion') ||
        word.endsWith('sion') ||
        word.endsWith('ment') ||
        word.endsWith('ness') ||
        word.endsWith('ity') ||
        word.endsWith('ance') ||
        word.endsWith('ence') ||
        word.endsWith('er') ||
        word.endsWith('or')) {
      return WordType.noun;
    }

    return WordType.unknown;
  }

  /// Ước lượng CEFR level
  CEFRLevel _estimateCEFR(String word) {
    if (_a1Words.contains(word)) return CEFRLevel.a1;
    if (_a2Words.contains(word)) return CEFRLevel.a2;
    if (_b1Words.contains(word)) return CEFRLevel.b1;
    if (word.length <= 4) return CEFRLevel.a1;
    if (word.length <= 6) return CEFRLevel.a2;
    if (word.length <= 8) return CEFRLevel.b1;
    if (word.length <= 10) return CEFRLevel.b2;
    return CEFRLevel.c1;
  }

  /// Quick meaning lookup (basic dictionary)
  String? _getQuickMeaning(String word, WordType type) {
    return _basicDict[word];
  }

  /// Xóa cache
  void clearCache() => _cache.clear();

