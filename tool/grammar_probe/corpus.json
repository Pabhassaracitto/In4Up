{
  "_doc": "Corpus vàng cho spike cụm từ + cấu trúc câu (Tab Đọc). Mỗi case: câu, từ được chạm (anchor), và kết quả ĐÚNG về mặt ngữ pháp. Dùng để đo độ chính xác của engine.py; khi port sang Dart, file này là nguồn sinh test.",
  "conventions": {
    "phrase.span": "Chuỗi con LIÊN TỤC của câu (đúng như trong nguồn) ứng với cụm NHỎ NHẤT chứa anchor.",
    "cau_hoi_span_verb_group": "Trong câu hỏi, nhóm động từ bị chủ ngữ chen giữa vẫn lấy span liền mạch gồm cả chủ ngữ (vd 'Did you have') — UI sẽ làm mờ phần chủ ngữ.",
    "VP": "Nhóm động từ hữu hạn (trợ động từ + phủ định + trạng từ chen + động từ chính + tiểu từ) — KHÔNG gồm tân ngữ.",
    "PHRASAL_V": "Động từ + tiểu từ của cụm động từ cố định (+ đại từ chen giữa nếu có).",
    "sentence": "Chỉ so các trường ĐƯỢC KHAI BÁO; trường không khai báo = ngoài phạm vi case đó.",
    "clause_fields": "type/question/polarity/tense/aspect/voice/pattern LUÔN tính trên MỆNH ĐỀ CHÍNH; vai trò mệnh đề chứa anchor ghi ở clause_role.",
    "tense": "present | past | future | modal | none",
    "aspect": "simple | continuous | perfect | perfect_continuous | none",
    "pattern": "SV | SVO | SVC | SVOO | SVOC | SVOA | SVA | There+V+S | IT-CLEFT | VO | V",
    "tag_question": "Quyết định người sở hữu 2026-09-24: câu hỏi đuôi ⇒ type=declarative + question=tag (hiển thị 'Khẳng định + hỏi đuôi'), polarity theo MỆNH ĐỀ CHÍNH."
  },
